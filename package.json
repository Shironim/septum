{
  "name": "septum",
  "version": "0.2.0",
  "description": "Deterministic Bounded-Context, Structural File Catalog & Anti-Poisoning Partition for AI Agents",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "septum": "./bin/septum.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run bin/septum.ts",
    "serve": "bun run bin/septum.ts serve",
    "ingest": "bun run bin/septum.ts sync",
    "sync": "bun run bin/septum.ts sync",
    "check": "bun run bin/septum.ts check",
    "test": "bun test",
    "build": "bun build ./bin/septum.ts --compile --outfile dist/septum",
    "compile:all": "bun run build && bun build ./bin/septum.ts --compile --target=bun-linux-x64 --outfile dist/septum-linux-x64 && bun build ./bin/septum.ts --compile --target=bun-linux-arm64 --outfile dist/septum-linux-arm64 && bun build ./bin/septum.ts --compile --target=bun-darwin-x64 --outfile dist/septum-darwin-x64 && bun build ./bin/septum.ts --compile --target=bun-darwin-arm64 --outfile dist/septum-darwin-arm64 && bun build ./bin/septum.ts --compile --target=bun-windows-x64 --outfile dist/septum-windows-x64.exe",
    "typecheck": "tsc --noEmit",
    "test:integration": "python3 tests/integration/mcp-reliability.py",
    "postinstall": "bun run scripts/postinstall.ts || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "web-tree-sitter": "^0.24.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2",
    "tree-sitter-wasms": "^0.1.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shironim/septum.git"
  },
  "homepage": "https://github.com/shironim/septum#readme",
  "bugs": {
    "url": "https://github.com/shironim/septum/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bounded-context",
    "architecture",
    "ai-agent",
    "tree-sitter",
    "clean-architecture",
    "domain-driven-design",
    "codebase-catalog",
    "antigravity"
  ],
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
